# Release signing config for the directly-distributed (sideloaded) APK.
#
# Copy this file to "keystore.properties" (same folder) and fill in your real
# values. The real keystore.properties and the *.jks file are git-ignored, so
# your passwords never get committed.
#
#   cp keystore.properties.template keystore.properties
#
# storeFile : path to your keystore. Either absolute, or relative to the REPO
#             ROOT (this folder). Forward slashes work on Windows too.
storeFile=keystore/bpdigitizer-release.jks
storePassword=CHANGE_ME
keyAlias=bpdigitizer
keyPassword=CHANGE_ME
